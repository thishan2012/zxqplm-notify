# Copy to .env for local runs. NEVER commit the real .env.
# Without UPSTASH_* the code falls back to a local file store under ./state/ (git-ignored).

# From BotFather (https://t.me/BotFather) -> /newbot
TELEGRAM_BOT_TOKEN=

# From https://console.upstash.com -> your database -> REST API
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: comma-separated keywords that mark an incident as alertable.
# MAJOR_KEYWORDS=major,outage,critical,unavailable,down,disruption,service_outage
