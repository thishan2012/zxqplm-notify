# Copy to .env for local runs. NEVER commit the real .env.
# Without TURSO_* the code falls back to a local file store under ./state/ (git-ignored).

# From BotFather (https://t.me/BotFather) -> /newbot
TELEGRAM_BOT_TOKEN=

# From Turso (https://turso.tech) — database URL + access token.
# CLI: turso db show --url <db-name>   /   turso db tokens create <db-name>
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Optional: comma-separated keywords that mark an incident as alertable.
# MAJOR_KEYWORDS=major,outage,critical,unavailable,down,disruption,service_outage
